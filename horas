#!/bin/bash

USUARIO=$(whoami)
DIR_DATOS="/var/lib/horas"
CSV_FILE="$DIR_DATOS/registro_horas.csv"
AWK_SCRIPT="/usr/local/lib/trabajo.awk"
REPO_RAW="https://raw.githubusercontent.com/ManuA323/calculadorHorasTerminal/main"
NAVEGADOR_FILE="$DIR_DATOS/navegador"

# Detectar el usuario real si se usó sudo
REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(eval echo "~$REAL_USER")

# Detectar dinámicamente si el escritorio se llama "Escritorio" o "Desktop"
if [ -d "$REAL_HOME/Escritorio" ]; then
    DESKTOP_DIR="$REAL_HOME/Escritorio"
elif [ -d "$REAL_HOME/Desktop" ]; then
    DESKTOP_DIR="$REAL_HOME/Desktop"
else
    DESKTOP_DIR="$REAL_HOME"
fi

# Opción -u: Actualizar la herramienta ejecutando el instalador
if [ "$1" = "-u" ]; then
    echo "Buscando actualizaciones..."

    if curl --retry 5 --retry-delay 2 --retry-max-time 30 --retry-all-errors -fsSL "$REPO_RAW/install.sh" | bash; then
        echo "Actualización completada."
    else
        echo "Error: no se pudo descargar el instalador."
        exit 1
    fi

    exit 0
fi

# Opción -cat o -c: Mostrar el contenido del CSV en la terminal
if [ "$1" = "-cat" ] || [ "$1" = "-c" ]; then
    if [ -f "$CSV_FILE" ]; then
        column -s',' -t "$CSV_FILE"
    else
        echo "El archivo CSV ($CSV_FILE) aún no existe."
    fi
    exit 0
fi

# Opción -e: Exportar CSV al Escritorio del usuario
if [ "$1" = "-e" ]; then
    if [ -f "$CSV_FILE" ]; then
        DESTINO="$DESKTOP_DIR/registro_horas.csv"
        cp "$CSV_FILE" "$DESTINO"
        echo "CSV exportado exitosamente en: $DESTINO"
    else
        echo "No hay datos para exportar. El archivo CSV aún no existe."
    fi
    exit 0
fi

# Opción -navegador: Seleccionar navegador para abrir Gmail
if [ "$1" = "-navegador" ]; then
    mkdir -p "$DIR_DATOS" 2>/dev/null || true

    echo "Navegadores disponibles:"
    echo ""

    navegadores=()

    if command -v google-chrome >/dev/null 2>&1; then
        navegadores+=("Google Chrome|google-chrome")
    fi

    if command -v firefox >/dev/null 2>&1; then
        navegadores+=("Mozilla Firefox|firefox")
    fi

    if command -v chromium >/dev/null 2>&1; then
        navegadores+=("Chromium|chromium")
    fi

    if command -v chromium-browser >/dev/null 2>&1; then
        navegadores+=("Chromium Browser|chromium-browser")
    fi

    if command -v microsoft-edge >/dev/null 2>&1; then
        navegadores+=("Microsoft Edge|microsoft-edge")
    fi

    if [ ${#navegadores[@]} -eq 0 ]; then
        echo "No se encontraron navegadores compatibles."
        exit 1
    fi

    for i in "${!navegadores[@]}"; do
        nombre="${navegadores[$i]%%|*}"
        echo "$((i+1))) $nombre"
    done

    echo ""

    read -p "Seleccione un navegador [1-${#navegadores[@]}]: " opcion

    if ! [[ "$opcion" =~ ^[0-9]+$ ]] || [ "$opcion" -lt 1 ] || [ "$opcion" -gt "${#navegadores[@]}" ]; then
        echo "Selección inválida."
        exit 1
    fi

    navegador="${navegadores[$((opcion-1))]##*|}"
    nombre_navegador="${navegadores[$((opcion-1))]%%|*}"

    echo "$navegador" > "$NAVEGADOR_FILE"

    echo ""
    echo "Navegador seleccionado: $nombre_navegador"

    exit 0
fi

# Opción -help: Mostrar ayuda
if [ "$1" = "-help" ]; then
    echo "Comandos disponibles:"
    echo ""
    echo " 'horas' para calcular jornada."
    echo " 'horas -e' para exportar al escritorio en CSV."
    echo " 'horas -c' para visualizar el contenido del CSV."
    echo " 'horas -navegador' para seleccionar el navegador que abrirá Gmail."
    echo " 'horas -u' para actualizar la herramienta."
    echo " 'horas -help' para ver esta ayuda."
    echo " 'desinstalar-horas' para remover la herramienta del sistema."
    exit 0
fi

# Crear directorio si no existe y asegurar la cabecera del CSV
mkdir -p "$DIR_DATOS" 2>/dev/null || true

if [ ! -f "$CSV_FILE" ]; then
    echo "Fecha,Inicio,Fin" > "$CSV_FILE"
fi

# 1. Obtener la última fecha registrada en el CSV
ULTIMA_FECHA=$(tail -n +2 "$CSV_FILE" | cut -d',' -f1 | sort | tail -n 1)

# 2. Si el CSV está vacío, buscamos desde hace 15 días. Si tiene datos, desde la última fecha.
if [ -z "$ULTIMA_FECHA" ]; then
    FECHA_DESDE=$(date -d '15 days ago' '+%Y-%m-%d')
else
    FECHA_DESDE="$ULTIMA_FECHA"
fi

# 3. Consultar journalctl desde la última fecha registrada
LOGS_JOURNAL=$(journalctl -o short-iso --no-pager -S "$FECHA_DESDE 00:00:00" \
| grep -E "New session|System is powering down|The system will suspend now|PM: suspend entry|PM: suspend exit|Performing sleep operation|System returned from sleep operation|Waking up from system sleep")

# 4. Procesar en AWK
echo "$LOGS_JOURNAL" | awk -v usuario="$USUARIO" -v archivo_csv="$CSV_FILE" -f "$AWK_SCRIPT" "$CSV_FILE" -