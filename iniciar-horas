#!/bin/bash

MARCA="/var/lib/horas/ultima_ejecucion"
NAVEGADOR_FILE="/var/lib/horas/navegador"
CONFIG_TERM="/var/lib/horas/auto_terminal"
CONFIG_NAV="/var/lib/horas/auto_navegador"
FECHA_HOY=$(date '+%Y-%m-%d')
URL="https://mail.google.com/mail/u/0/#chat/home"

# Si ya se ejecutó hoy, no hacer nada
if [ -f "$MARCA" ] && [ "$(cat "$MARCA")" = "$FECHA_HOY" ]; then
    exit 0
fi

# Registrar la ejecución de hoy
mkdir -p /var/lib/horas
echo "$FECHA_HOY" > "$MARCA"

# 1. Ejecutar inicio automático de la terminal si está activado
if [ -f "$CONFIG_TERM" ] && [ "$(cat "$CONFIG_TERM")" = "1" ]; then
    gnome-terminal -- bash -c "horas; exec bash" &
fi

# 2. Abrir Gmail si el inicio automático de navegador está activado
if [ -f "$CONFIG_NAV" ] && [ "$(cat "$CONFIG_NAV")" = "1" ]; then
    if [ -f "$NAVEGADOR_FILE" ]; then
        NAVEGADOR=$(cat "$NAVEGADOR_FILE")

        if command -v "$NAVEGADOR" >/dev/null 2>&1; then
            "$NAVEGADOR" "$URL" &
        else
            xdg-open "$URL" &
        fi
    else
        xdg-open "$URL" &
    fi
fi